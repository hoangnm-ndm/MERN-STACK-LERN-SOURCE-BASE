# Sao chép thành .env. Với Vite, CHỈ biến có tiền tố VITE_ được nhúng vào bundle.
#
# CẢNH BÁO: mọi biến VITE_* đều LỘ trong JavaScript tải về máy người dùng.
# TUYỆT ĐỐI không đặt secret ở đây (API key, client secret, chuỗi kết nối DB).

VITE_API_URL=http://localhost:5000/api/v1

# Tên ứng dụng hiển thị trên giao diện
VITE_APP_NAME=MERN Base
