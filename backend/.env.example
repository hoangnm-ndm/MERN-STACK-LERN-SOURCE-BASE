# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Mọi biến ở đây được validate bằng Zod tại src/shared/config/env.js — thiếu biến
# bắt buộc thì server thoát ngay khi khởi động (fail fast).

# --- Ứng dụng ---
NODE_ENV=development                      # development | test | production
PORT=5000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173          # dùng cho CORS whitelist và link trong email

# --- Database ---
# Cần replicaSet để dùng transaction (docker-compose.yml đã dựng sẵn rs0)
MONGODB_URI=mongodb://localhost:27017/mern_base?replicaSet=rs0&directConnection=true

# --- JWT ---
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m                        # access token nên ngắn (15-30 phút)
JWT_REFRESH_TTL=30d                       # refresh token dài hơn, có xoay vòng

# --- Token dùng một lần (verify email, magic link, reset password) ---
VERIFY_EMAIL_TTL_MINUTES=60
MAGIC_LINK_TTL_MINUTES=15
RESET_PASSWORD_TTL_MINUTES=30

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM="MERN Base <no-reply@example.com>"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=                       # domain public để đọc file, ví dụ https://cdn.example.com
R2_PRESIGN_TTL_SECONDS=300
UPLOAD_MAX_SIZE_MB=5

# --- Scheduler ---
SCHEDULER_ENABLED=true                    # tắt ở môi trường test để job không tự chạy
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
ORPHAN_MEDIA_GRACE_HOURS=24               # ảnh mồ côi cũ hơn mốc này mới bị dọn

# --- Seed ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
