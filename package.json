{
  "name": "tuananh-mern-stack",
  "private": true,
  "type": "module",
  "workspaces": ["backend", "frontend"],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:down": "npm run db:migrate:down -w backend",
    "db:seed": "npm run db:seed -w backend",
    "email:dev": "npm run email:dev -w backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,json,css,md}": "prettier --write"
  }
}
